    {
      "slug": "velocity",
      "name": "Velocity",
      "summary": "A native macOS download manager that splits files into parallel streams, resumes broken downloads and stays quietly in the menu bar.",
      "status": "live",
      "platforms": [
        "macos"
      ],
      "tech": [
        "Swift",
        "SwiftUI",
        "Network framework",
        "Core Data"
      ],
      "links": {
        "appStore": "https://example.com/velocity/app-store",
        "github": "https://example.com/alpha-studios/velocity"
      },
      "repo": "alpha-studios-demo/velocity",
      "featured": true,
      "origin": "studio",
      "founderName": "",
      "story": "Large downloads on a Mac should not be a gamble. Velocity breaks every file into parallel streams, checks each piece as it arrives and resumes exactly where a connection dropped, even after a restart. It is written natively in Swift and SwiftUI, so it opens instantly, sips battery and looks at home in the menu bar. A clean queue, bandwidth limits and a scheduler keep big transfers out of the way of your work. Hari designed the architecture, Eldho built the transfer engine and Rohan set up licensing.",
