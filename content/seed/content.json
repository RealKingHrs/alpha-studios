    {
      "slug": "lumen",
      "name": "Lumen",
      "summary": "A study planner that turns deadlines into small, doable evenings and cheers you on when you finish one.",
      "status": "beta",
      "platforms": [
        "web",
        "android"
      ],
      "tech": [
        "React",
