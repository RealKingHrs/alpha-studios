      "slug": "bioscanner",
      "name": "Bioscanner",
      "summary": "Point your camera at a plant, insect or sample and get an identification with a clear confidence score.",
      "status": "beta",
      "platforms": [
        "ios",
        "android",
        "web"
      ],
